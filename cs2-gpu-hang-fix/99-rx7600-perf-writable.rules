# Libera escrita no power_dpm_force_performance_level da RX 7600 (03:00.0)
# pro grupo 'render', pra o wrapper cs2-stable fixar/soltar clock sem sudo.
ACTION=="add|bind", SUBSYSTEM=="pci", KERNEL=="0000:03:00.0", RUN+="/bin/sh -c 'chgrp render /sys/bus/pci/devices/0000:03:00.0/power_dpm_force_performance_level; chmod g+w /sys/bus/pci/devices/0000:03:00.0/power_dpm_force_performance_level'"
